FROM ubuntu:24.04

RUN apt-get update && \
    DEBIAN_FRONTEND="noninteractive" apt-get install --yes \
    git \
    sudo \
    python3 \
    apt-utils \
    wget \
    curl \
    make \
    gcc \
    iproute2 \
    iptables \
    nftables \
    apt-transport-https \
    ca-certificates \
    curl \
    gcc \
    g++ \
    make \
    acl \
    net-tools \
    git-lfs \
    bc \
    dmsetup \
    gnupg-agent \
    numactl \
    software-properties-common

COPY scripts/github_runner/setup_runner.sh /setup_runner.sh
COPY scripts/create_devmapper.sh /create_devmapper.sh
COPY scripts/install_pmutools.sh /install_pmutools.sh
# Jobs install/verify the manifest-pinned stack and render its configuration.
# Do not bake an old kernel or an unrendered STACK_PREFIX template into runners.
ENTRYPOINT /setup_runner.sh
